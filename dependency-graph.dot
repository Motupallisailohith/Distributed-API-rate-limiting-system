  com_Motupallisailohith_ratelimit_Main -> com_Motupallisailohith_ratelimit_reliability_ReliabilityModule;
  com_Motupallisailohith_ratelimit_reliability_ReliabilityModule -> com_Motupallisailohith_ratelimit_protocol_Packet;
  com_Motupallisailohith_ratelimit_reliability_ReliabilityModule -> com_Motupallisailohith_ratelimit_bucket_RateLimiter;

  // Legend
  subgraph cluster_legend {
    label="Legend";
    style=filled;
    color="#FFFFFF";
    fontsize=10;
    node [fontsize=10];
    legend_class [label="Class", fillcolor="#B3E5FC", shape=box];
    legend_interface [label="Interface", fillcolor="#C8E6C9", shape=diamond];
